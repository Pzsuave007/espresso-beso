# Espresso Beso Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=espresso_beso

# JWT Secret (generate a random string)
JWT_SECRET=your_jwt_secret_here

# Stripe Payment (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# VAPID Keys for Push Notifications (generated by setup script)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PayPal (optional, if using PayPal)
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
